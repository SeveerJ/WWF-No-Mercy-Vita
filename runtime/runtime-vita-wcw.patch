+static void vita_copy_file(const std::filesystem::path& from, const std::filesystem::path& to, std::error_code& ec) {
+    ec = {};
+    FILE* in = fopen(from.string().c_str(), "rb");
+    if (!in) { ec = std::error_code(errno, std::generic_category()); fprintf(stderr, "[save] can't open %s: %s\n", from.string().c_str(), strerror(errno)); return; }
+    FILE* out = fopen(to.string().c_str(), "wb");
